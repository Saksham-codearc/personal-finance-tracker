# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (leave blank to use the local in-memory database)
MONGO_URI=

# Use a long random value in production, e.g. `openssl rand -hex 32`
JWT_SECRET=finora-local-development-secret-change-me
JWT_EXPIRES_IN=7d

# Comma-separated frontend origins allowed by CORS
CLIENT_URL=http://localhost:5173

# Set to true to create the demo account when using a real MongoDB database
SEED_DEMO=false
